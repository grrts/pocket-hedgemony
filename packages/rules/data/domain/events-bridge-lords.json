  "event.lord_nuno_alvares_pereira.name": "The Holy Constable",
  "event.lord_nuno_alvares_pereira.desc": "Nuno Álvares Pereira, a young knight who stood for the Master of Aviz in the crisis, asks for his reward: the constable's staff and the county of Ourém.",
  "event.lord_nuno_alvares_pereira.option.welcome": "Make him Constable",
  "event.lord_nuno_alvares_pereira.option.refuse": "Keep him at court",
  "event.lord_john_hunyadi.name": "The White Knight",
  "event.lord_john_hunyadi.desc": "John Hunyadi, a knight of Wallachian blood who has fought for the king in Italy and on the Danube, is named Ban of Severin to hold the border against the Turks.",
  "event.lord_john_hunyadi.option.welcome": "Give him the banate",
  "event.lord_john_hunyadi.option.refuse": "Keep the border in the crown's hands",
  "event.lord_skirgaila.name": "Skirgaila takes Trakai",
  "event.lord_skirgaila.desc": "Kęstutis's line has lost the Grand Duke's favour. Jogaila's brother Skirgaila asks for the duchy of Trakai.",
  "event.lord_skirgaila.option.welcome": "Give Trakai to Skirgaila",
  "event.lord_skirgaila.option.refuse": "Leave Trakai to its old line",
  "event.lord_jan_zizka.name": "The one-eyed captain",
  "event.lord_jan_zizka.desc": "Jan Žižka, a one-eyed knight of small estate, has become the Hussites' first captain and holds the castle he calls Kalich.",
  "event.lord_jan_zizka.option.welcome": "Recognise his lordship",
  "event.lord_jan_zizka.option.refuse": "Refuse him",
  "event.lord_manuel_ii_palaiologos.name": "Manuel holds Thessalonica",
  "event.lord_manuel_ii_palaiologos.desc": "Prince Manuel, freed after his years in prison, sails to Thessalonica and rules the city as despot, defying the Turks.",
  "event.lord_manuel_ii_palaiologos.option.welcome": "Let Manuel rule Thessalonica",
  "event.lord_manuel_ii_palaiologos.option.refuse": "Order him back to the capital",
  "event.lord_aleksandras_olelka.name": "Olelka restored in Kiev",
  "event.lord_aleksandras_olelka.desc": "Aleksandras Olelka, son of Vladimir Olgerdovich, asks for Kiev, the principality his father held.",
  "event.lord_aleksandras_olelka.option.welcome": "Restore him in Kiev",
  "event.lord_aleksandras_olelka.option.refuse": "Keep Kiev as it is",
  "event.lord_zhu_di.name": "The Prince of Yan",
  "event.lord_zhu_di.desc": "The emperor's fourth son, Zhu Di, Prince of Yan, comes of age and goes to his fief at Beiping on the northern frontier.",
  "event.lord_zhu_di.option.welcome": "Send him to Beiping",
  "event.lord_zhu_di.option.refuse": "Keep him at Nanjing",
  "event.lord_zafar_khan.name": "A governor for Gujarat",
  "event.lord_zafar_khan.desc": "Zafar Khan, son of a convert who rose at the Sultan's court, is sent to govern Gujarat.",
  "event.lord_zafar_khan.option.welcome": "Send Zafar Khan",
  "event.lord_zafar_khan.option.refuse": "Keep Gujarat under the court",
  "event.lord_dilawar_khan_ghuri.name": "A governor for Malwa",
  "event.lord_dilawar_khan_ghuri.desc": "Dilawar Khan Ghuri is given Malwa to govern from Dhar.",
