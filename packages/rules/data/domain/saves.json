{
  "format": {
    "extension": ".phsave",
    "magic": "PHSV",
    "compression": "deflate",
    "thumbnail": {
      "width": 96,
      "height": 64
    },
    "format_version": 1,
    "container_version": 1,
    "file_name": "<campaignId>/<savedAt>-<saveId>.phsave",
    "chunks": [
      "core",
      "ids",
      "provinces",
      "nations",
      "armies",
      "events",
      "history",
      "orders"
    ],
    "chunk_versions": {
      "core": 1,
      "ids": 1,
      "provinces": 1,
      "nations": 1,
      "armies": 1,
      "events": 1,
      "history": 1,
      "orders": 1
    },
    "build_data": [
      "adjacency",
      "terrain",
      "water",
      "rivers",
      "province shapes"
    ],
    "not_in_save": [
      "rules",
      "map shapes",
      "art",
      "settings",
      "purchases",
      "achievement progress"
    ]
  },
  "kinds": {
    "resume": {
      "keep": 2,
      "write_on": [
        "end_turn",
        "pause",
        "quit",
        "suspend",
        "exit_to_menu"
      ]
    },
    "autosave": {
      "interval_months": 12,
      "interval_options": [
        1,
        6,
        12,
        "off"
      ],
      "keep": 3,
      "keep_options": [
        1,
        3,
        5
      ],
      "interval_labels": {
        "1": "every month",
        "6": "every 6 months",
        "12": "every 12 months (each January)",
        "off": "off"
      },
      "every_12_month": 1,
      "every_6_months": [
        1,
        7
      ]
    },
    "manual": {
      "max_per_campaign": 20,
      "max_total": 100
    },
    "ironman": {
      "keep": 2,
      "write_on": [
        "end_turn",
        "pause",
        "quit",
        "suspend",
        "exit_to_menu"
      ]
    }
  },
  "orders_journal": {
    "write_on": [
      "pause",
      "quit",
      "suspend",
      "background",
      "exit_to_menu"
    ],
    "safety_interval_seconds": 30
  },
  "budgets": {
    "file_kb_start": 400,
    "file_kb_late": 2048,
    "write_ms": 300,
    "journal_write_ms": 20,
    "header_read_ms": 5,
    "load_ms": 1500
  },
  "cloud": {
    "synced": {
      "manual": "all",
      "resume": "latest",
      "ironman": "latest",
      "autosave": "latest"
    },
    "local_only": [
      "older_autosaves",
      "resume_backup",
      "orders_journal"
    ],
    "server": {
      "enabled": true,
      "max_save_mb": 2,
      "quota_saves": 300,
      "quota_mb": 200,
      "tombstone_purge_days": 30,
      "sync_on": [
        "launch",
        "resume",
        "after_save"
      ],
      "wifi_only_default": false,
      "ironman_head_check": true,
      "access_token_minutes": 15,
      "sign_in_throttle": {
        "max_attempts": 5,
        "interval_minutes": 15
      }
    },
    "store_backups": {
      "steam": {
        "method": "auto_cloud",
        "quota_mb": 500,
        "quota_files": 2000,
        "dynamic_cloud_sync": true,
        "folder": "Electron userData/saves",
        "root_overrides": [
          "windows",
          "macos",
          "linux"
        ]
      },
      "android": {
        "auto_backup": true,
        "limit_mb": 25
      },
      "ios": {
        "device_backup": true
      },
      "web": {
        "indexeddb_persist": true
      },
      "not_used": [
        "Play Games saved games",
        "iCloud Documents container"
      ]
    },
    "synced_files": [
      "settings-personal.json"
    ]
  },
  "export_import": true,
  "ironman": {
    "allow_export": true,
    "conflict": "ask_once",
    "recommended_choice": "furthest_turn"
  },
  "integrity": {
    "chunk_crc": "crc32",
    "verify_world_hash": true,
    "modified_saves": "allowed_outside_ironman_with_warning"
  },
  "_source": "save-system/save-config.example.yaml, plus the numbers and texts the save-system README states (see domain/saves/spec.md)",
  "desktop_quit_wait_seconds": 2,
  "tombstone_purge_days": 30,
  "messages": {
    "saved": "Saved.",
    "no_space": "There isn't enough space on this device to save. Free some space, or delete old saves.",
    "newer_version": "This save is from a newer version of Pocket Hegemony. Update the game to open it.",
    "damaged_fallback": "This save is damaged. The previous save from {date} was opened instead.",
    "locked_nation": "{nation} is part of the full game. Unlock it to continue this campaign.",
    "replace": "Replace?",
    "ironman_split": "Keep the game from {a} ({a_date}) or from {b} ({b_date})?",
    "continue": "Continue: {nation}, {date}",
    "continue_from": "Continue: {nation}, {date} (from {device})",
    "new_save": "New save",
    "load_newer_first": "Load the newer game first.",
    "ironman_import_offline": "Connect to import an ironman save."
  },
  "free_tier": {
    "free_nations": [
      "ottomans",
      "france"
    ]
  },
  "platform_events": {
    "ios": {
      "App plugin pause": "pause",
      "appStateChange to inactive": "background"
    },
    "android": {
      "App plugin pause": "pause"
    },
    "desktop": {
      "window close": "quit",
      "before-quit": "quit",
      "powerMonitor suspend": "suspend"
    },
    "web": {
      "visibilitychange to hidden": "background",
      "pagehide": "quit"
    }
  },
  "secure_storage": {
    "ios": "Keychain",
    "android": "Keystore",
    "desktop": "safeStorage"
  },
  "sign_in": {
    "at_launch": {
      "steam": [
        "Steam",
        "email and password"
      ],
      "ios": [
        "Sign in with Apple",
        "Steam",
        "email and password"
      ],
      "android": [
        "Google",
        "Steam",
        "email and password"
      ],
      "web": [
        "Steam",
        "Google",
        "Sign in with Apple",
        "email and password"
      ]
    },
    "ios_needs": "Sign in with Apple",
    "steam_ticket_identity": "pockethegemony"
  },
  "export": {
    "android": "share sheet",
    "ios": "share sheet",
    "desktop": "save dialog"
  },
  "_provisional": [
    "desktop_quit_wait_seconds",
    "kinds.autosave.every_6_months",
    "orders_journal.safety_interval_seconds"
  ]
}
