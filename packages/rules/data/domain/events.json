{
 "$comment": "Event tree rules (domain/events/spec.md). balance = event-tree/data/balance.yaml; vocabulary, enums and statistics are the event tree's closed lists. All balance values are placeholders.",
 "campaign": {
  "end_date": "1939-08-31",
  "out_of_scope_ages": [
   "age_of_decolonization",
   "cold_war",
   "age_of_globalization"
  ],
  "events_choice": {
   "$comment": "D-EVT-9: the new-game 'Events' choice; its value picks the alternate history preset.",
   "default": "Plausible",
   "values": {
    "Historical": "historical",
    "Plausible": "plausible",
    "Free": "divergent"
   }
  },
  "$comment": "D-EVT-1: events whose history starts after end_date are dropped when a campaign loads; out_of_scope_ages never start (X-14)."
 },
 "balance": {
  "selection": {
   "pool_roll_interval_months": 1,
   "max_pool_events_per_country_year": 2,
   "decision_expiry_years": 10,
   "alternate_history_mode": {
    "historical": {
     "follow_up_boost_mult": 1.5,
     "historical_option_mult": 2.0,
     "mean_years_mult": 0.8
    },
    "plausible": {
     "follow_up_boost_mult": 1.0,
     "historical_option_mult": 1.0,
     "mean_years_mult": 1.0
    },
    "divergent": {
     "follow_up_boost_mult": 0.6,
     "historical_option_mult": 0.5,
     "mean_years_mult": 1.3
    }
   }
  },
  "follow_ups": {
   "max_boost": 5.0,
   "boost_decay_years": 10
  },
  "ai_factors": {
   "at_war": "Country is at war.",
   "low_treasury": "Treasury below one year of expenses.",
   "high_unrest": "More than half the country's provinces have 4 or more grievances (Plotting).",
   "same_religion": "Other party shares state religion.",
   "rival": "Other party is a rival.",
   "great_power": "Country ranks in the top 8 by great_power_score.",
   "threatened": "A hostile neighbour has more than 1.5x army_strength."
  },
  "rebel_sizes": {
   "$comment": "D-EVT-5: share of the province's recruit pool that rises (X-9). Same 1:2:4:8 steps as the tree's sizes.",
   "small": 0.125,
   "medium": 0.25,
   "large": 0.5,
   "huge": 1.0
  },
  "modifier_rules": {
   "default_stacking": "refresh",
   "max_stacks": 3,
   "exponential_half_life_share": 0.5
  },
  "coverage": {
   "min_events_per_region_age": 2,
   "min_agency_share": 0.35
  },
  "validation_checks": [
   "Every referenced id (age, period, event, entity, region, area, province, modifier, source, stat, flag) exists.",
   "Every condition and effect type is declared in vocabulary.yaml with known parameters.",
   "Roles referenced as $role are declared in the event; every event has at least one role.",
   "Each event has 2+ options, exactly one historical option, and unique option ids.",
   "narrative_only events offer no option with a positive stat or prestige payoff to the perpetrator.",
   "Mandatory prerequisite graph (requires / event conditions in triggers) has no cycles (Tarjan SCC).",
   "Earliest possible date propagated through prerequisites never exceeds an event's latest date (no impossible triggers).",
   "Mutually exclusive events are never both mandatory prerequisites of a third event.",
   "Entities referenced in a trigger exist at the event's date or are created by a reachable earlier event.",
   "Flags read by triggers are set by some effect or declared as system flags.",
   "Ages and periods have start and end conditions; periods lie inside at least one of their ages.",
   "Coverage: events per macro-region per age, and agency share per region."
  ],
  "date_binding": {
   "$comment": "EVT-019: approximate events weigh their pool chance toward the history date; mandatory events fire in their last year if the trigger holds.",
   "approximate_peak_mult": 2.0,
   "approximate_spread_years": 10
  },
  "options": {
   "$comment": "D-EVT-7",
   "min": 2,
   "max": 4
  }
 },
