    "en": {
      "tut.ch0.pan": "Murad's lands lie on both shores of the straits. Move the map to look around.",
      "tut.ch0.find_edirne": "{place:edirne} is your capital. {place:bursa}, across the water, keeps the tombs of your house.",
      "tut.ch0.zoom": "Zoom in on {place:gallipoli}. Its crossing joins Anatolia to Thrace, and it is yours again.",
      "tut.ch0.open_card": "Open the card of {place:edirne} to see its people, food and garrison.",
      "tut.ch0.food_lens": "Switch to the Food lens. Hungry provinces carry a hunger icon.",
      "tut.ch0.faith_lens": "Most of your people in Rumelia are Orthodox Christians. You rule them as a Sunni bey.",
      "tut.ch4.choose_emperor": "John V has escaped and asks for your help. Back him, or keep Andronikos IV on the throne?",
      "tut.ch4.vizier_pencik": "The corps is strong. This is what it costs the villages that fill it.",
      "tut.ch5.lost_clash": "Your army broke. Fall back behind the walls of Edirne and call the levy.",
      "tut.ch6.open_food_policy": "Your castles feed the land around them. Open {ui:food_policy}.",
      "tut.ch6.choose_marriage": "Germiyan offers a bride for Bayezid, with {place:kutahya} as her dowry. Its castles would join your reach.",
      "tut.idle.stuck": "Stuck? {btn:skip_step} to skip this step."
    }
