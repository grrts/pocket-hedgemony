  "scripted_events": [
    {
      "id": "tut_byzantine_tribute",
      "name": "Tribute from Constantinople",
      "date": "autumn 1378",
      "tutorial_only": true,
      "chapter": 1,
      "history": {
        "summary": "Andronikos IV, who seized Constantinople on 12 August 1376 with Genoese and Ottoman help, pays Murad tribute and has handed back Gallipoli. His father John V and brother Manuel II are in his prison.",
        "sources": [
          "start-date research: east, Ottoman 1378 opening (Murad's Frontier)"
        ]
      },
      "options": [
        "Take the tribute",
        "Ask after John V"
      ]
    },
    {
      "id": "tut_john_escapes",
      "name": "John V and Manuel reach Murad",
      "date": "June 1379",
      "tutorial_only": true,
      "chapter": 4,
      "history": {
        "summary": "John V and Manuel II escape from prison in June 1379 and go to Murad, offering more tribute and service for his help against Andronikos IV.",
        "sources": [
          "start-date research: east, Ottoman 1378 opening (Murad's Frontier)"
        ]
      },
      "line": "John V and Manuel have escaped to Murad",
      "options": [
        "Back John V",
        "Keep Andronikos IV"
      ]
    },
    {
      "id": "tut_city_retaken",
      "name": "John V back in Constantinople",
      "date": "1 July 1379",
      "tutorial_only": true,
      "chapter": 5,
      "history": {
        "summary": "John V retakes Constantinople on 1 July 1379 with Ottoman troops and Venetian ships; Andronikos IV flees to Genoese Pera with hostages, and the siege of Pera follows (1379-1381).",
        "sources": [
          "start-date research: east, Ottoman 1378 opening (Murad's Frontier)"
        ]
      },
      "line": "John V is back in Constantinople; Andronikos holds out in Pera"
    },
    {
      "id": "tut_settlement_1381",
      "name": "The settlement of 1381",
      "date": "May 1381",
      "tutorial_only": true,
      "chapter": 5,
      "history": {
        "summary": "In May 1381 Andronikos IV is made heir again and given Selymbria and Thracian towns; John V's tribute and service to Murad are raised (medium confidence).",
        "sources": [
          "start-date research: east, Ottoman 1378 opening (Murad's Frontier)"
        ]
      }
    },
    {
      "id": "tut_germiyan_marriage",
      "name": "A bride for Bayezid",
      "date": "1381",
      "tutorial_only": true,
      "chapter": 6,
      "history": {
        "summary": "Prince Bayezid marries Devlet Hatun, daughter of Süleyman Şah of Germiyan; her dowry is Kütahya, Simav, Eğrigöz and Tavşanlı. Dated 1381 by the Ottoman chronicles (Aşıkpaşazade, Neşri), 1378 by some modern works; the 1378 start keeps Kütahya with Germiyan, so the tutorial uses 1381.",
        "sources": [
          "start-date research: east, Ottoman 1378 opening (Murad's Frontier)"
        ]
      },
      "options": [
        "Accept the marriage",
        "Press Germiyan by war"
      ]
    },
    {
      "id": "tut_hamid_towns",
      "name": "The Hamid towns for sale",
      "date": "1381",
      "tutorial_only": true,
      "chapter": 6,
      "history": {
        "summary": "Kemaleddin Hüseyin of Hamid, pressed by Karaman, sells Akşehir, Beyşehir, Seydişehir, Yalvaç and Karaağaç to Murad. Dated 1381 by the chronicles, c.1374-75 by some; the 1378 start leaves the sale ahead, so the tutorial uses 1381.",
        "sources": [
          "start-date research: east, Ottoman 1378 opening (Murad's Frontier)"
        ]
      },
      "options": [
        "Buy the towns",
        "Leave them to Hamid"
      ]
    },
    {
      "id": "tut_manuel_thessaloniki",
      "name": "Manuel goes to Thessaloniki",
      "date": "1382",
      "tutorial_only": true,
      "chapter": 7,
      "history": {
        "summary": "In 1382 Manuel II takes Thessaloniki as his own base, to resist Murad in Macedonia.",
        "sources": [
          "start-date research: east, Ottoman 1378 opening (Murad's Frontier)"
        ]
      },
      "line": "Manuel has made Thessaloniki his own base"
    }
  ],
