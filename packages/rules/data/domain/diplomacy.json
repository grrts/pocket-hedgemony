{
 "$comment": "Diplomacy context config. 'relations' is copied from country-relations/config/relation-rules.json (relation model, matrix, actions, durations); the rest from diplomacy/diplomacy-rules.json. Every number is a placeholder balancing knob owned by game design. Subject kinds: the engine reads relations.subject_kinds only for labels; joining wars and own diplomacy follow the six kinds of subjects.json (X-8, D-DIPL-10).",
 "schema_version": "1.0",
 "_provisional": [
  "actions.fund_rebels.gold_share_of_target_yearly_income",
  "actions.fund_rebels.caught_chance_per_month",
  "ledger.ties.backed_our_revolution",
  "ledger.standing_limit",
  "envoys.passage_denied_blocks_months",
  "envoys.days_per_crossing_unit",
  "eras.VI.pact_offensive_call_bonus",
  "ledger.wrongs.grabbed_land_near_us",
  "ai.notoriety_restraint"
 ],
 "relations": {
  "layers": {
   "hierarchy": {
    "types": [
     "subject"
    ],
    "rule": "A country has at most one direct overlord. Chains are allowed (a subject may have subjects); cycles are not."
   },
   "state": {
    "types": [
     "at_war",
     "truce",
     "alliance"
    ],
    "rule": "At most one state relation per unordered pair."
   },
   "stance": {
    "types": [
     "friendly",
     "neutral",
     "rival",
     "hostile"
    ],
    "rule": "At most one stance per perspective (A towards B). A mutual stance record fills both perspectives; a one-way record fills only source towards target. With no stance stored, the game uses the default stance, which is not a historical claim."
   }
  },
  "default_stance": "neutral",
  "implied_stance": {
   "$comment": "Effective stance when none is stored for a perspective: at war reads as hostile, allies read as friendly, everything else falls back to default_stance.",
   "at_war": "hostile",
   "alliance": "friendly"
  },
  "types": {
   "alliance": {
    "label": "Alliance",
    "layer": "state",
    "direction": "mutual",
    "stored": true,
    "definition": "A formal, mutual commitment to support one another in war.",
    "applies_when": "There is a treaty, sworn league or documented joint war effort binding both sides. Friendship, marriage or a shared enemy alone is not enough.",
    "duration": {
     "kind": "open_ended",
     "default_months": null,
     "expires_on_end_date": false
    },
    "establish_actions": [
     "form_alliance",
     "peace_term_force_alliance"
    ],
    "terminate_actions": [
     "break_alliance",
     "declare_war",
     "make_subject",
     "country_destroyed"
    ],
    "ai": {
     "call_to_arms_weight": 1.0,
     "attack_ally_weight": -1.0
    },
    "modifiers": "alliance"
   },
   "friendly": {
    "label": "Friendly",
    "layer": "stance",
    "direction": "mutual_or_one_way",
    "stored": true,
    "definition": "Active cooperation or warm diplomatic relations without a binding war commitment.",
    "applies_when": "Documented cooperation: a peace treaty kept in good faith, dynastic or political partnership, joint diplomacy, or protection without formal subjection.",
    "duration": {
     "kind": "open_ended",
     "decay_months": 240
    },
    "establish_actions": [
     "improve_relations",
     "royal_marriage",
     "gift",
     "event_outcome"
    ],
    "terminate_actions": [
     "insult",
     "declare_war",
     "set_rival",
     "event_outcome",
     "decay"
    ],
    "ai": {
     "alliance_candidate_weight": 0.5
    },
    "modifiers": "friendly"
   },
   "neutral": {
    "label": "Neutral",
    "layer": "stance",
    "direction": "mutual_or_one_way",
    "stored": true,
    "definition": "No significant alignment or hostility.",
    "applies_when": "Store it only when neutrality is itself a documented, meaningful fact (a declared neutrality, a deliberate abstention from a war both sides tried to draw the country into). Otherwise leave the pair empty and let the game apply the default stance.",
    "duration": {
     "kind": "open_ended"
    },
    "establish_actions": [
     "declare_neutrality",
     "decay"
    ],
    "terminate_actions": [
     "any_stance_change"
    ],
    "ai": {},
    "modifiers": "neutral"
   },
   "rival": {
    "label": "Rival",
    "layer": "stance",
    "direction": "mutual_or_one_way",
    "stored": true,
    "definition": "Competition for territory, power, a throne, influence or trade.",
    "applies_when": "A documented contested object: a disputed province, crown, trade route, sphere or office. Neighbourhood alone never makes a rivalry.",
    "duration": {
     "kind": "open_ended",
     "min_months_before_change": 120
    },
    "establish_actions": [
     "set_rival",
     "event_outcome",
     "peace_term_claim_left_open"
    ],
    "terminate_actions": [
     "drop_rival",
     "country_destroyed",
     "contested_object_resolved"
    ],
    "ai": {
     "war_target_weight": 0.6,
     "ally_against_weight": 0.5
    },
    "modifiers": "rival"
   },
   "hostile": {
    "label": "Hostile",
    "layer": "stance",
    "direction": "mutual_or_one_way",
    "stored": true,
    "definition": "Serious antagonism or an ongoing dispute that may lead to war: raiding, feuds, a revolt-in-waiting, a broken treaty.",
    "applies_when": "Documented raids, open disputes, recent betrayal, or a subject openly working against its overlord. Stronger than rivalry; the two never coexist in one perspective.",
    "duration": {
     "kind": "open_ended",
     "decay_months": 120,
     "decays_to": "rival"
    },
    "establish_actions": [
     "insult",
     "border_raid",
     "break_truce",
     "event_outcome",
     "war_ends_without_reconciliation"
    ],
    "terminate_actions": [
     "improve_relations",
     "peace_with_reconciliation",
     "decay"
    ],
    "ai": {
     "war_target_weight": 1.0,
     "border_fort_weight": 0.5
    },
    "modifiers": "hostile"
   },
   "at_war": {
    "label": "At War",
    "layer": "state",
    "direction": "mutual",
    "stored": true,
    "definition": "The two countries are actively fighting.",
    "applies_when": "A declared war or campaign is in progress on the reference date, or a state of war continues with no peace or truce concluded.",
    "duration": {
     "kind": "until_peace",
     "war_exhaustion_peace_months": 60
    },
    "establish_actions": [
     "declare_war",
     "join_war_as_ally",
     "join_war_as_subject",
     "independence_war",
     "event_outcome"
    ],
    "terminate_actions": [
     "make_peace",
     "white_peace",
     "country_destroyed"
    ],
    "ai": {},
    "modifiers": "at_war"
   },
   "subject": {
    "label": "Subject",
    "layer": "hierarchy",
    "direction": "directed",
    "stored": true,
    "source_role": "subject",
    "target_role": "overlord",
    "definition": "The source country is politically subordinate to the target and owes defined obligations (tribute, troops, homage, investiture).",
    "applies_when": "A documented obligation exists: tribute actually owed, fief held, investiture received, estate within a composite crown. Influence, protection or cultural sway is not subjection.",
    "duration": {
     "kind": "open_ended"
    },
    "establish_actions": [
     "peace_term_vassalize",
     "diplomatic_vassalize",
     "inheritance_union",
     "event_outcome"
    ],
    "terminate_actions": [
     "independence_war_won",
     "release_subject",
     "annex_subject",
     "overlord_destroyed",
     "event_outcome"
    ],
    "kinds": "subject_kinds",
    "ai": {},
    "modifiers": "subject"
   },
   "overlord": {
    "label": "Overlord",
    "layer": "hierarchy",
    "direction": "directed",
    "stored": false,
    "derived_from": "subject",
    "definition": "The country that holds authority over a subject. Always derived by reading a subject record from the other end; never stored.",
    "applies_when": "Exactly when a subject record names this country as target."
   },
   "truce": {
    "label": "Truce",
    "layer": "state",
    "direction": "mutual",
    "stored": true,
    "definition": "A temporary agreement not to resume hostilities after a conflict.",
    "applies_when": "A truce or peace treaty concluded after a conflict is in force on the reference date. Use the treaty's own term as expires_on when one is recorded.",
    "duration": {
     "kind": "fixed",
     "default_months": 60,
     "historical_term_overrides_default": true
    },
    "establish_actions": [
     "make_peace",
     "white_peace",
     "negotiate_truce",
     "event_outcome"
    ],
    "terminate_actions": [
     "expires",
     "break_truce",
     "form_alliance",
     "make_subject"
    ],
    "ai": {
     "break_truce_weight": -1.0
    },
    "modifiers": "truce"
   }
  },
  "subject_kinds": {
   "vassal": {
    "label": "Vassal",
    "obligations": [
     "military_service",
     "homage"
    ],
    "can_conduct_own_diplomacy": true,
    "joins_overlord_wars": "defensive"
   },
   "tributary": {
    "label": "Tributary",
    "obligations": [
     "tribute"
    ],
    "can_conduct_own_diplomacy": true,
    "joins_overlord_wars": "never"
   },
   "personal_union": {
    "label": "Junior partner in a personal union",
    "obligations": [
     "shared_ruler"
    ],
    "can_conduct_own_diplomacy": false,
    "joins_overlord_wars": "always"
   },
   "estate": {
    "label": "Constituent estate of a composite realm",
    "obligations": [
     "taxes",
     "military_service"
    ],
    "can_conduct_own_diplomacy": false,
    "joins_overlord_wars": "always",
    "note": "Kingdoms, principalities, magnate blocs or leagues inside a larger crown that the catalogue records as separate actors."
   },
   "appanage": {
    "label": "Appanage or princely apanage",
    "obligations": [
     "homage",
     "military_service"
    ],
    "can_conduct_own_diplomacy": false,
    "joins_overlord_wars": "always"
   },
   "fief": {
    "label": "Fief held from a sovereign suzerain",
    "obligations": [
     "homage",
     "census_or_investiture"
    ],
    "can_conduct_own_diplomacy": true,
    "joins_overlord_wars": "never",
    "note": "For example a kingdom held as a papal fief: real legal obligation, very high autonomy."
   },
   "colony": {
    "label": "Overseas or colonial dependency",
    "obligations": [
     "governor_appointed",
     "trade_monopoly"
    ],
    "can_conduct_own_diplomacy": false,
    "joins_overlord_wars": "always"
   },
   "frontier_commandery": {
    "label": "Frontier commandery or guard under imperial titles",
    "obligations": [
     "tribute_missions",
     "border_service"
    ],
    "can_conduct_own_diplomacy": true,
    "joins_overlord_wars": "never"
   }
  },
  "autonomy_levels": [
   "very_low",
   "low",
   "moderate",
   "high",
   "very_high"
  ],
  "compatibility": {
   "$comment": "Pair-level rules, read regardless of direction. Pairs not listed are allowed. 'forbidden' is a validation error; 'redundant' is a warning (store only the stronger relation); 'allowed_with_note' must carry a note in the record.",
   "rules": [
    {
     "a": "alliance",
     "b": "at_war",
     "result": "forbidden"
    },
    {
     "a": "alliance",
     "b": "truce",
     "result": "forbidden"
    },
    {
     "a": "at_war",
     "b": "truce",
     "result": "forbidden"
    },
    {
     "a": "subject",
     "b": "at_war",
     "result": "forbidden",
     "note": "A subject that fights its overlord has left the hierarchy: record the independence war, not both."
    },
    {
     "a": "subject",
     "b": "truce",
     "result": "forbidden"
    },
    {
     "a": "subject",
     "b": "alliance",
     "result": "forbidden",
     "note": "The subject's obligations already cover what an alliance would."
    },
    {
     "a": "subject",
     "b": "neutral",
     "result": "forbidden"
    },
    {
     "a": "alliance",
     "b": "hostile",
     "result": "forbidden"
    },
    {
     "a": "alliance",
     "b": "neutral",
     "result": "forbidden"
    },
    {
     "a": "alliance",
     "b": "friendly",
     "result": "redundant",
     "note": "Alliance already implies a friendly stance."
    },
    {
     "a": "alliance",
     "b": "rival",
     "result": "allowed_with_note",
     "note": "Allies may compete over a contested object (for example a throne or a frontier)."
    },
    {
     "a": "at_war",
     "b": "friendly",
     "result": "forbidden"
    },
    {
     "a": "at_war",
     "b": "neutral",
     "result": "forbidden"
    },
    {
     "a": "subject",
     "b": "friendly",
     "result": "redundant",
     "note": "A loyal subject is the default; store friendly only if it says more than loyalty."
    },
    {
     "a": "subject",
     "b": "hostile",
     "result": "allowed_with_note",
     "note": "A disloyal subject; feeds the revolt risk."
    },
    {
     "a": "subject",
     "b": "rival",
     "result": "allowed_with_note",
     "note": "A subject competing with its overlord for power."
    }
   ]
  },
  "precedence": {
   "$comment": "When gameplay creates a relation that is incompatible with an existing one, the newer relation wins and ends the older one, except where an action is blocked by 'requires'. When two stored historical records conflict, validation fails: precedence never silently fixes data.",
   "order": [
    "at_war",
    "truce",
    "subject",
    "alliance",
    "hostile",
    "rival",
    "friendly",
    "neutral"
   ]
  },
  "actions": {
   "declare_war": {
    "requires": {
     "no_relation": [
      "alliance",
      "truce"
     ],
     "not_subject_of_target": true
    },
    "ends": [
     "friendly",
     "neutral"
    ],
    "sets_stance_if_missing": "hostile",
    "note": "Breaking an alliance or truce first is a separate action with its own cost."
   },
   "independence_war": {
    "actor": "subject",
    "ends": [
     "subject"
    ],
    "creates": "at_war",
    "sets_stance": "hostile",
    "on_overlord_victory": "restore_subject"
   },
   "make_peace": {
    "ends": [
     "at_war"
    ],
    "creates": "truce",
    "truce_months_from": "truce.duration.default_months",
    "may_create": [
     "subject"
    ],
    "stance_after": "keep_or_hostile"
   },
   "white_peace": {
    "ends": [
     "at_war"
    ],
    "creates": "truce",
    "stance_after": "rival_if_hostile"
   },
   "extend_truce": {
    "requires": {
     "relation": "truce"
    },
    "sets": "expires_on",
    "note": "Prolongs an existing truce; history did this repeatedly (England-France 1444-49)."
   },
   "break_truce": {
    "ends": [
     "truce"
    ],
    "sets_stance": "hostile",
    "penalty": "truce_breaking"
   },
   "form_alliance": {
    "requires": {
     "stance_not": [
      "hostile"
     ],
     "no_relation": [
      "at_war"
     ],
     "not_subject_pair": true
    },
    "ends": [
     "truce",
     "neutral"
    ],
    "creates": "alliance"
   },
   "break_alliance": {
    "ends": [
     "alliance"
    ],
    "penalty": "alliance_breaking"
   },
   "make_subject": {
    "ends": [
     "alliance",
     "truce",
     "at_war",
     "neutral"
    ],
    "creates": "subject"
   },
   "release_subject": {
    "ends": [
     "subject"
    ],
    "sets_stance": "friendly"
   },
   "set_rival": {
    "requires": {
     "contested_object": true
    },
    "ends": [
     "friendly",
     "neutral"
    ],
    "creates": "rival"
   },
   "insult": {
    "ends": [
     "friendly"
    ],
    "creates": "hostile"
   },
   "improve_relations": {
    "steps": [
     "hostile",
     "rival",
     "neutral",
     "friendly"
    ]
   },
   "truce_expires": {
    "ends": [
     "truce"
    ]
   },
   "country_destroyed": {
    "ends": [
     "all"
    ]
   }
  },
  "fact_types": {
   "$comment": "Diplomatic facts are optional context attached to a pair. They are not relations, never block or imply a relation type, and feed modifiers only.",
   "royal_marriage": {
