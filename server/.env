# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# Production: Postgres (see compose.yaml)
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> pocket-hegemony ###
# Origins the game clients load from: Vite dev server, Electron, Capacitor iOS, Capacitor Android.
CORS_ALLOW_ORIGINS="http://localhost:5173,app://game,capacitor://localhost,https://localhost"
# Where the website's Play buttons go (the hosted web game). Empty hides them.
PLAY_URL=
# The game's store pages, for the website's store buttons. Each empty one hides its button.
STORE_APP_STORE_URL=
STORE_GOOGLE_PLAY_URL=
STORE_STEAM_URL=
# Steam sign-in (SAVE-113): the publisher Web API key and the full game's app id. Empty turns Steam sign-in off.
STEAM_WEB_API_KEY=
STEAM_APP_ID=
# Store sign-ins on phones and the web (domain/saves SAVE-149 … SAVE-154); each is off while empty.
# Sign in with Apple: the app's bundle id and the website's Services ID, comma separated.
APPLE_CLIENT_IDS=
# Sign in with Apple's key (Certificates, Identifiers & Profiles → Keys, with Sign in with Apple), so deleting an
# account can revoke Apple's token (SAVE-203, SAVE-204): the team id, the key id, the .p8 file as a path from server/
# or an absolute one, and the website's return address for its sign-in. Without them nothing is revoked.
APPLE_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_KEY=
APPLE_SIGN_IN_REDIRECT_URI=
# Google sign-in: the OAuth client ids whose tokens the server takes (the web client, which Android names as its server client).
GOOGLE_CLIENT_IDS=
# Steam in the browser: where the server may send the browser back with the one-time code, comma separated
# (the phone app's pockethegemony://auth/steam and the web game's page, e.g. https://play.example.org/).
SIGN_IN_RETURN_URLS=
# Purchases of the full game (SAVE-170 … SAVE-178, docs/purchases.md). Steam's ownership check uses the
# two Steam settings above. A store whose settings are empty answers "… purchases are not available".
# App Store: the bundle id, and Apple Root CA - G3 (AppleRootCA-G3.cer from apple.com/certificateauthority),
# as a path from server/ or an absolute one. Sandbox transactions only when APPLE_ACCEPT_SANDBOX=1.
APPLE_BUNDLE_ID=
APPLE_ROOT_CERTIFICATE=
APPLE_PRODUCT_ID=full_game
APPLE_ACCEPT_SANDBOX=0
APPLE_APP_APPLE_ID=
# Google Play: the package name, the service account's JSON key (the JSON itself or a path to the file), and
# the secret token at the end of the Pub/Sub push URL (…/api/stores/google/notifications?token=<it>).
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT=
GOOGLE_PLAY_PRODUCT_ID=full_game
GOOGLE_PUBSUB_PUSH_TOKEN=
# Where cloud save bytes are kept (SAVE-061). With S3_BUCKET set they go to S3-compatible storage, which
# every app server shares (docs/deploy.md); otherwise to the folder SAVES_DIR, unset var/saves/<environment>.
# SAVES_DIR=/srv/pocket-hegemony/saves
# S3_BUCKET=pocket-hegemony-saves
# S3_PREFIX=saves
# S3_REGION=auto
# Leave S3_ENDPOINT empty for AWS; R2, B2 and MinIO give an https:// endpoint. MinIO needs S3_PATH_STYLE=1.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PATH_STYLE=0
# The address players can write to, shown on the press and privacy pages. Empty hides it.
SUPPORT_EMAIL=
###< pocket-hegemony ###
