{% extends 'site/layout.html.twig' %}

{% block title %}{{ status_code == 404 ? 'Page not found' : 'Something went wrong' }} · Pocket Hegemony{% endblock %}
{% block meta %}<meta name="robots" content="noindex">{% endblock %}

{% block content %}
<article class="framed sheet lost">
    <div class="prose">
        <h1>{{ status_code == 404 ? 'Lost at sea' : 'The scribes dropped their quills' }}</h1>
        <p>{{ status_code == 404 ? 'No page lives at this address. It may have moved, or the link has a typo.' : 'This page failed to load. Try again in a moment.' }}</p>
        <p><a class="btn paper" href="{{ path('wiki') }}">Go to the wiki</a></p>
    </div>
</article>
{% endblock %}
