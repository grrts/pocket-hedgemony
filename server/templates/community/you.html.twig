{% extends 'community/layout.html.twig' %}
{% import 'community/_parts.html.twig' as parts %}

{% block title %}{{ account.displayName }} · Pocket Hegemony community{% endblock %}
{% block meta %}<meta name="robots" content="noindex">{% endblock %}

{% block community %}
<section class="framed sheet narrow">
    <p class="crumbs"><a href="{{ path('community') }}">Community</a> › Your account</p>
    <header class="you-head">
        {{ parts.seal(account) }}
        <div>
            <h1>{{ account.displayName }}</h1>
            <p class="muted">{{ account.email }} · joined {{ account.createdAt|date('j M Y') }}{% if account.moderator %} · moderator{% endif %}</p>
        </div>
    </header>
    <div class="mod-tools">
        <a class="btn wax" href="{{ path('community_new') }}">{{ parts.icon('scroll') }}New topic</a>
        {% if account.moderator %}<a class="btn paper" href="{{ path('community_reports') }}">Reports</a>{% endif %}
        <form method="post" action="{{ path('community_signout') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button class="btn paper" type="submit">Sign out</button>
        </form>
    </div>
    <h2 class="c-h2">Your shared saves</h2>
    {% if shared %}
    <ol class="topics compact shared-list">
        {% for save in shared %}
        <li class="topic-row">
            <a class="topic-title" href="{{ path('community_post', {id: save.post.id}) }}">{{ save.title }}</a>
            <p class="topic-meta"><span>{{ save.realm }} · {{ save.dateText }}</span> <span>code {{ save.shownCode }}</span></p>
            <div class="topic-last">
                <span class="replies">Played <strong>{{ save.plays }}</strong> {{ save.plays == 1 ? 'time' : 'times' }}</span>
                <details class="shared-remove">
                    <summary class="btn paper">Remove</summary>
                    <form method="post" action="{{ path('community_shared_remove', {code: save.code}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('community-post') }}">
                        <span>Remove this shared save? Its topic stays.</span>
                        <button class="btn wax" type="submit">Remove it</button>
                    </form>
                </details>
            </div>
        </li>
        {% endfor %}
    </ol>
    {% else %}
    <p class="empty">You have not shared a save yet. In the game, open a save under Load and tap Share.</p>
    {% endif %}
    <h2 class="c-h2">Your topics</h2>
    {% if topics %}
    <ol class="topics compact">
        {% for topic in topics %}{{ parts.topic_row(topic, null) }}{% endfor %}
    </ol>
    {% else %}
    <p class="empty">You have not started a topic yet.</p>
    {% endif %}
</section>
{% endblock %}
