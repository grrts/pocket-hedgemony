{% extends 'community/layout.html.twig' %}
{% import 'community/_parts.html.twig' as parts %}

{% block title %}Sign in · Pocket Hegemony community{% endblock %}
{% block meta %}<meta name="robots" content="noindex">{% endblock %}

{% block community %}
<section class="framed sheet narrow account-form">
    <h1>Sign in</h1>
    <p>Sign in with your Pocket Hegemony account.</p>
    {% if error %}<p class="field-error" role="alert">{{ error }}</p>{% endif %}
    <form method="post" action="{{ path('community_signin') }}" class="c-form">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        {% if next %}<input type="hidden" name="next" value="{{ next }}">{% endif %}
        <label class="field-label" for="signin-email">Email</label>
        <input id="signin-email" type="email" name="email" value="{{ email }}" required autocomplete="email" autocapitalize="off" spellcheck="false"{% if not email %} autofocus{% endif %}>
        <label class="field-label" for="signin-password">Password</label>
        <input id="signin-password" type="password" name="password" required autocomplete="current-password"{% if email %} autofocus{% endif %}>
        <label class="check"><input type="checkbox" name="remember" value="1" checked> Stay signed in on this device</label>
        <div class="form-row">
            <p class="hint">No account yet? <a href="{{ path('community_join', next ? {next: next} : {}) }}">Join</a></p>
            <button class="btn wax" type="submit">Sign in</button>
        </div>
    </form>
</section>
{% endblock %}
