{
  "name": "pocket-hegemony",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @ph/client dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "specs": "pnpm --filter @ph/specs report",
    "bench": "pnpm --filter @ph/engine bench",
    "desktop": "pnpm --filter @ph/client build && pnpm --filter @ph/desktop start",
    "wiki": "node --experimental-strip-types tools/wiki-data.ts && node --experimental-strip-types tools/wiki-export.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "marked": "18.0.14",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
