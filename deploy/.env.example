# Copy to deploy/.env and fill in (docs/deploy.md). deploy/.env is never committed.

# The address players open, without https://. Its DNS A record must point at this server.
DOMAIN=play.example.com

# Make each with: openssl rand -hex 32   (letters and digits only, see docs/deploy.md)
POSTGRES_PASSWORD=
APP_SECRET=

# Optional: shown on the press and privacy pages.
SUPPORT_EMAIL=
