{
  "appId": "com.pockethegemony.app",
  "appName": "Pocket Hegemony",
  "webDir": "../client/dist",
  "backgroundColor": "#1a1c2c",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "minWebViewVersion": 80
  },
  "plugins": {
    "SocialLogin": {
      "providers": {
        "google": true,
        "apple": true,
        "facebook": false,
        "twitter": false
      },
      "logLevel": 1
    }
  }
}
